# Copy to project.env next to these scripts (target-owned; never overwritten).

# Stage policy: pre-alpha is advisory unless PY_QA_ENFORCE=1.
PY_QA_STAGE="pre-alpha"
PY_QA_ENFORCE="0"

# Coverage gate (line %). 0 while wiring tests; raise per milestone.
PY_COVERAGE_MIN_LINE="0"
PY_COVERAGE_ENFORCE="0"

# Optional lanes.
PY_AUDIT_ENABLE="0"      # pip-audit in check_quality.sh
PY_BENCH_ENABLE="0"      # pytest -m bench --benchmark-only in run_qa_matrix.sh

# Runner override. Default: `uv run` when uv.lock exists and uv is installed.
# PY_RUNNER=""            # set to "" for bare commands in an activated venv

# Golden gate defaults.
GOLDEN_LOG_PATH="docs/ENGINEERING_LOG.md"
